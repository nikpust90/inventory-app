// Отчет по остаткам (HTTP GET)
Функция stock_reportGET(Запрос)
	// 1. Получаем параметры из URL
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	
	ИдентификаторыСкладов = Новый Массив;
	Если ЗначениеЗаполнено(ПараметрыЗапроса["warehouse"]) Тогда
		Для Каждого ID Из СтрРазделить(ПараметрыЗапроса["warehouse"], ",") Цикл
			ИдентификаторыСкладов.Добавить(СокрЛП(ID)); // СокрЛП для удаления пробелов
		КонецЦикла;
	КонецЕсли;
	
	// 2. Преобразуем массив строковых UUID в Массив ссылок 1С
	МассивСсылокСкладов = Новый Массив;
	Для Каждого ИД Из ИдентификаторыСкладов Цикл
		Попытка
			УИД = Новый УникальныйИдентификатор(ИД);
			СсылкаНаСклад = Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(УИД);
			Если НЕ СсылкаНаСклад.Пустая() Тогда
				МассивСсылокСкладов.Добавить(СсылкаНаСклад);
			КонецЕсли;
		Исключение
			// Игнорируем некорректные UUID
		КонецПопытки;
	КонецЦикла;
	
	// Если массив складов пуст - возвращаем пустой результат
	Если МассивСсылокСкладов.Количество() = 0 Тогда
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки("[]", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Возврат Ответ;
	КонецЕсли;
	
	// 3. Формирование и выполнение запроса (остатки, резервы, товары в пути)
	Запрос1С = Новый Запрос;
	Запрос1С.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос1С.Текст = 
	"ВЫБРАТЬ
	|		СерииНоменклатурыОстатки.Номенклатура КАК Номенклатура,
	|		СерииНоменклатурыОстатки.Серия КАК Серия,
	|		СерииНоменклатурыОстатки.Серия.Наименование КАК СерияНаименование,
	|		СерииНоменклатурыОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|		СУММА(СерииНоменклатурыОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|	ПОМЕСТИТЬ втСерии
	|	ИЗ
	|		РегистрНакопления.СерииНоменклатуры.Остатки(&ДатаДокумента, СтруктурнаяЕдиница В (&МассивСсылокСкладов)) КАК СерииНоменклатурыОстатки
	|	ГДЕ
	|		СерииНоменклатурыОстатки.КоличествоОстаток > 0
	|	СГРУППИРОВАТЬ ПО
	|		СерииНоменклатурыОстатки.Номенклатура,
	|		СерииНоменклатурыОстатки.Серия,
	|		СерииНоменклатурыОстатки.Серия.Наименование,
	|		СерииНоменклатурыОстатки.СтруктурнаяЕдиница
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ
	|		ЗапасыОстатки.Номенклатура КАК Номенклатура,
	|		ЗапасыОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|		СУММА(ЗапасыОстатки.КоличествоОстаток) КАК ОбщийОстаток,
	|		СУММА(ВЫБОР
	|				КОГДА ЗапасыОстатки.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|					ТОГДА 0
	|				ИНАЧЕ ЗапасыОстатки.КоличествоОстаток
	|			КОНЕЦ) КАК Резерв
	|	ПОМЕСТИТЬ втОстаткиИРезервы
	|	ИЗ
	|		РегистрНакопления.Запасы.Остатки(&ДатаДокумента, СтруктурнаяЕдиница В (&МассивСсылокСкладов)) КАК ЗапасыОстатки
	|	СГРУППИРОВАТЬ ПО
	|		ЗапасыОстатки.Номенклатура,
	|		ЗапасыОстатки.СтруктурнаяЕдиница
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	// 1. Выбираем документы Перемещения, которые ""едут"" к нам на склады
	|	// Условие: Дата документа + Дней доставки > Текущей даты отчета
	|	ВЫБРАТЬ
	|		ДокПеремещение.Ссылка КАК Ссылка,
	|		ДокПеремещение.СтруктурнаяЕдиницаПолучатель КАК Склад
	|	ПОМЕСТИТЬ втДокументыВПути
	|	ИЗ
	|		Документ.ПеремещениеЗапасов КАК ДокПеремещение
	|	ГДЕ
	|		ДокПеремещение.Проведен = ИСТИНА
	|		И ДокПеремещение.СтруктурнаяЕдиницаПолучатель В(&МассивСсылокСкладов)
	|		И ДОБАВИТЬКДАТЕ(ДокПеремещение.Дата, ДЕНЬ, ЕСТЬNULL(ДокПеремещение.ЦИТ_ДнейНаДоставку, 0)) > &ДатаДокумента
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	// 2. Получаем движения (Расход) по этим документам из регистра Запасы
	|	ВЫБРАТЬ
	|		Запасы.Номенклатура КАК Номенклатура,
	|		Запасы.Характеристика КАК Характеристика,
	|		Т.Склад КАК СтруктурнаяЕдиница,
	|		СУММА(Запасы.Количество) КАК КоличествоВПути
	|	ПОМЕСТИТЬ втТоварыВПути
	|	ИЗ
	|		РегистрНакопления.Запасы КАК Запасы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДокументыВПути КАК Т
	|			ПО Запасы.Регистратор = Т.Ссылка
	|	ГДЕ
	|		Запасы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Запасы.Номенклатура,
	|		Запасы.Характеристика,
	|		Т.Склад
	|	;
	|	
	|	////////////////////////////////////////////////////////////////////////////////
	|	ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|		Остатки.СтруктурнаяЕдиница КАК Склад,
	|		Остатки.СтруктурнаяЕдиница.Наименование КАК СкладНаименование,
	|		Остатки.Номенклатура КАК Номенклатура,
	|		Остатки.Номенклатура.Наименование КАК НоменклатураНаименование,
	|		Остатки.ОбщийОстаток,
	|		Остатки.Резерв,
	|		Остатки.ОбщийОстаток - Остатки.Резерв КАК СвободныйОстаток,
	|		ЕСТЬNULL(втТоварыВПути.КоличествоВПути, 0) КАК ТоварыВПути,
	|		втСерии.Серия КАК Серия,
	|		втСерии.СерияНаименование КАК СерияНаименование
	|	ИЗ
	|		втОстаткиИРезервы КАК Остатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ втСерии КАК втСерии
	|			ПО Остатки.Номенклатура = втСерии.Номенклатура
	|				И Остатки.СтруктурнаяЕдиница = втСерии.СтруктурнаяЕдиница
	|			ЛЕВОЕ СОЕДИНЕНИЕ втТоварыВПути КАК втТоварыВПути
	|			ПО Остатки.Номенклатура = втТоварыВПути.Номенклатура
	|				И Остатки.СтруктурнаяЕдиница = втТоварыВПути.СтруктурнаяЕдиница
	|	ГДЕ
	|		Остатки.ОбщийОстаток > 0
	|	
	|	УПОРЯДОЧИТЬ ПО
	|		СкладНаименование,
	|		НоменклатураНаименование,
	|		СерияНаименование";
	
	// Установка параметров
	Запрос1С.УстановитьПараметр("ДатаДокумента", ТекущаяДата());
	Запрос1С.УстановитьПараметр("МассивСсылокСкладов", МассивСсылокСкладов);
	
	РезультатЗапроса = Запрос1С.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	// 4. Группировка результата: склад -> номенклатура -> серии
	МассивРезультат = Новый Массив;
	ТекущийСклад = Неопределено;
	ТекущаяНоменклатура = Неопределено;

	Пока Выборка.Следующий() Цикл
		// Обработка нового склада
		Если ТекущийСклад = Неопределено ИЛИ ТекущийСклад.warehouseId <> Строка(Выборка.Склад.УникальныйИдентификатор()) Тогда
			ТекущийСклад = Новый Структура;
			ТекущийСклад.Вставить("warehouseId", Строка(Выборка.Склад.УникальныйИдентификатор()));
			ТекущийСклад.Вставить("warehouseName", Выборка.СкладНаименование);
			ТекущийСклад.Вставить("items", Новый Массив);
			МассивРезультат.Добавить(ТекущийСклад);
			ТекущаяНоменклатура = Неопределено;
		КонецЕсли;

		// Обработка новой номенклатуры
		Если ТекущаяНоменклатура = Неопределено ИЛИ ТекущаяНоменклатура.nomenclatureId <> Строка(Выборка.Номенклатура.УникальныйИдентификатор()) Тогда
			ТекущаяНоменклатура = Новый Структура;
			ТекущаяНоменклатура.Вставить("nomenclatureId", Строка(Выборка.Номенклатура.УникальныйИдентификатор()));
			ТекущаяНоменклатура.Вставить("nomenclatureName", Выборка.НоменклатураНаименование);
			ТекущаяНоменклатура.Вставить("totalQuantity", Выборка.ОбщийОстаток);
			ТекущаяНоменклатура.Вставить("reserveQuantity", Выборка.Резерв);
			ТекущаяНоменклатура.Вставить("freeQuantity", Выборка.СвободныйОстаток);
			// Добавили новое поле
			ТекущаяНоменклатура.Вставить("inTransitQuantity", Выборка.ТоварыВПути); 
			ТекущаяНоменклатура.Вставить("series", Новый Массив);
			ТекущийСклад.items.Добавить(ТекущаяНоменклатура);
		КонецЕсли;

		// Добавляем серию, если она есть
		Если ЗначениеЗаполнено(Выборка.Серия) Тогда
			СтруктураСерии = Новый Структура;
			СтруктураСерии.Вставить("seriyaId", Строка(Выборка.Серия.УникальныйИдентификатор()));
			СтруктураСерии.Вставить("seriya", Выборка.СерияНаименование);
			СтруктураСерии.Вставить("imei", ""); // или реальное значение IMEI если есть
			ТекущаяНоменклатура.series.Добавить(СтруктураСерии);
		КонецЕсли;
	КонецЦикла;
	
	// 5. Сериализация в JSON
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивРезультат);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Возврат Ответ;
	Исключение
		Возврат СформироватьОтветСОшибкой(500, "Ошибка сериализации JSON: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Прием ссылки на Яндекс.Диск и привязка к документам (HTTP POST)
Функция upload_photo_infoPOST(Запрос)
	Попытка
        
        // --- 1. Получаем тело POST-запроса ---
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Возврат СформироватьОтветСОшибкой(400, "Пустое тело запроса");
        КонецЕсли;

        // --- 2. Парсим JSON ---
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();

        // --- 3. Проверяем и извлекаем корневые данные из JSON ---
        Если Не ЗначениеЗаполнено(ДанныеЗапроса["photoFolderUrl"]) 
           ИЛИ Не ЗначениеЗаполнено(ДанныеЗапроса["documentIds"]) 
           ИЛИ Не ЗначениеЗаполнено(ДанныеЗапроса["userName"]) Тогда
            Возврат СформироватьОтветСОшибкой(400, "Не все поля (photoFolderUrl, documentIds, userName) заполнены");
        КонецЕсли;
        
        СсылкаНаПапку = ДанныеЗапроса["photoFolderUrl"];
        МассивIDДокументов = ДанныеЗапроса["documentIds"]; // Это будет Массив 1С
        ИмяПользователя = ДанныеЗапроса["userName"];

        // --- 4. Обрабатываем КАЖДЫЙ документ из массива ---
        // Мы будем использовать МенеджерЗаписи для логики "Добавить или Обновить" (UPSERT)
        
        Для Каждого СтрокаID Из МассивIDДокументов Цикл
            
            // 5.1. Получаем ссылку на документ по УИД
            ДокументУИД = Новый УникальныйИдентификатор(СтрокаID);
            ДокументСсылка = Документы.ИнвентаризацияЗапасов.ПолучитьСсылку(ДокументУИД);

            Если ДокументСсылка.Пустая() Тогда
                // Если какой-то документ не найден, просто пропускаем его
                // и продолжаем со следующим, не прерывая весь запрос.
                Сообщить("UploadPhotoInfoPOST: Не найден документ с ID: " + СтрокаID);
                Продолжить; 
            КонецЕсли;
            
            // 5.2. Получаем Склад из документа (он нужен для регистра)
            // ⚠️ ВНИМАНИЕ: Получение объекта может быть медленным.
            // Если есть ОбщегоНазначения.ЗначениеРеквизитаОбъекта - лучше использовать его.
            // Для простоты используем ПолучитьОбъект().
            Попытка
                ДокОбъект = ДокументСсылка.ПолучитьОбъект();
                СкладСсылка = ДокОбъект.СтруктурнаяЕдиница;
            Исключение
                Сообщить("UploadPhotoInfoPOST: Не удалось получить склад из документа " + СтрокаID + ". " + ОписаниеОшибки());
                Продолжить; // Пропускаем этот документ
            КонецПопытки;
            
            // 5.3. Создаем Менеджер Записи
            МенеджерЗаписи = РегистрыСведений.ЦИТ_СсылкиНаЯндексДискДляИнв.СоздатьМенеджерЗаписи();
            
            // 5.4. Заполняем Измерение (Ключ записи)
            МенеджерЗаписи.ИнвентаризацияСсылка = ДокументСсылка;
            
            // 5.5. Читаем запись (если она есть, менеджер заполнится)
            МенеджерЗаписи.Прочитать();
            
            // 5.6. Заполняем/Обновляем Ресурсы
			МенеджерЗаписи.ИнвентаризацияСсылка = ДокументСсылка;
            МенеджерЗаписи.Склад = СкладСсылка;
            МенеджерЗаписи.СсылкаНаЯндексДиск = СсылкаНаПапку;
            МенеджерЗаписи.Пользователь = ИмяПользователя;
            
            // 5.7. Записываем (1С сама решит, обновить существующую или добавить новую)
            МенеджерЗаписи.Записать();
            
        КонецЦикла;

        // --- 6. Возвращаем успешный ответ ---
        ДанныеОтвета = Новый Структура;
        ДанныеОтвета.Вставить("success", Истина);
        ДанныеОтвета.Вставить("message", "Ссылки на Яндекс.Диск успешно обновлены");

        Ответ = Новый HTTPСервисОтвет(200);
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

        Возврат Ответ;
        
    Исключение
        Возврат СформироватьОтветСОшибкой(500, "Ошибка при обновлении ссылок: " + ОписаниеОшибки());
    КонецПопытки;
КонецФункции




