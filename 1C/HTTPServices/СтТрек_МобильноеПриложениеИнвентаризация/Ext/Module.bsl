

// Авторизация по PIN-коду (HTTP POST)
Функция LoginByPinPOSTPOST(Запрос)
	Попытка
		// 1. Читаем и парсим JSON тела запроса
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		
		ПинКод = ДанныеЗапроса["pin"];
		Если ПустаяСтрока(ПинКод) Тогда
			Возврат СформироватьОтветСОшибкой(400, "ПИН-код не передан");
		КонецЕсли;

		// 2. Ищем пользователя по ПИН-коду
		Запрос1С = Новый Запрос;
		Запрос1С.Текст = 
		"ВЫБРАТЬ
		|	ПинКоды.Пользователь КАК Пользователь,
		|	ПинКоды.РольПоСкладам КАК Роль,
		|	ПинКоды.Админ КАК Админ
		|ИЗ
		|	РегистрСведений.СтТрек_ПинКодыПользователей КАК ПинКоды
		|ГДЕ
		|	ПинКоды.ПинКод = &ПинКод";
		
		Запрос1С.УстановитьПараметр("ПинКод", ПинКод);
		Результат = Запрос1С.Выполнить().Выбрать();
		
		// Используем соответствие для уникальности складов
		// Ключом будет ID склада, Значением - Истина. 
		// Если склад попадет второй раз, он просто перезапишется, дубля не будет.
		УникальныеСклады = Новый Соответствие;
		
		Пользователь = Неопределено;
		Админ = Неопределено;
		ЕстьЗаписи = Ложь;
		
		Пока Результат.Следующий() Цикл
			ЕстьЗаписи = Истина;
			Пользователь = Результат.Пользователь;
			Админ = Результат.Админ;
			
			Если ЗначениеЗаполнено(Результат.Роль) Тогда
				
				// Запрос выбирает все склады (включая вложенные в группы)
				ЗапросСклады = Новый Запрос;
				ЗапросСклады.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	СпрСклады.Ссылка КАК СкладСсылка
				|ИЗ
				|	Справочник.СтруктурныеЕдиницы КАК СпрСклады
				|ГДЕ
				|	СпрСклады.Ссылка В ИЕРАРХИИ
				|			(ВЫБРАТЬ
				|				ТЧ.Склад
				|			ИЗ
				|				Справочник.СтТрек_РолиПоСкладам.Склады КАК ТЧ
				|			ГДЕ
				|				ТЧ.Ссылка = &Роль)
				|	И НЕ СпрСклады.ПометкаУдаления";
				
				ЗапросСклады.УстановитьПараметр("Роль", Результат.Роль);
				ВыборкаСкладов = ЗапросСклады.Выполнить().Выбрать();
				
				Пока ВыборкаСкладов.Следующий() Цикл
					ИдСклада = Строка(ВыборкаСкладов.СкладСсылка.УникальныйИдентификатор());
					// Вставляем в соответствие. Дубли отсеются сами.
					УникальныеСклады.Вставить(ИдСклада, Истина);
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
		
		// 4. Формируем ответ
		Если ЕстьЗаписи Тогда
			
			// Перекладываем уникальные ключи из Соответствия в Массив
			МассивСкладов = Новый Массив;
			Для Каждого КлючИЗначение Из УникальныеСклады Цикл
				МассивСкладов.Добавить(КлючИЗначение.Ключ);
			КонецЦикла;
			
			ДанныеОтвета = Новый Структура;
			ДанныеОтвета.Вставить("userName", Пользователь);
			ДанныеОтвета.Вставить("warehouseIds", МассивСкладов);
			ДанныеОтвета.Вставить("admin", Админ);
			
			Возврат СформироватьУспешныйОтветJSON(ДанныеОтвета);
		Иначе
			Возврат СформироватьОтветСОшибкой(404, "Пользователь с таким ПИН-кодом не найден");
		КонецЕсли;
		
	Исключение
		Возврат СформироватьОтветСОшибкой(500, "Внутренняя ошибка сервера: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Список документов инвентаризации (HTTP GET)
Функция GetInventoryDocumentsGET(Запрос)
	// 1. Получаем параметры из URL
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	СтатусДокумента = ПараметрыЗапроса["status"];

	// warehouse приходит строкой UUID, разделенных запятой
	ИдентификаторыСкладов = Новый Массив;
	Если ЗначениеЗаполнено(ПараметрыЗапроса["warehouse"]) Тогда
	    Для Каждого ID Из СтрРазделить(ПараметрыЗапроса["warehouse"], ",") Цикл
	        ИдентификаторыСкладов.Добавить(СтрЗаменить(ID, " ", ""));
	    КонецЦикла;
	КонецЕсли;
	
	// 2. Преобразуем массив строковых UUID в Массив ссылок 1С
	МассивСсылокСкладов = Новый Массив;
	Для Каждого ИД Из ИдентификаторыСкладов Цикл
		// Защита от некорректных UUID
		Попытка
			УИД = Новый УникальныйИдентификатор(ИД);
			СсылкаНаСклад = Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(УИД);
			Если Не СсылкаНаСклад.Пустая() Тогда // Добавляем только существующие ссылки
				МассивСсылокСкладов.Добавить(СсылкаНаСклад);
			КонецЕсли;
		Исключение
			// Игнорируем некорректные или отсутствующие UUID и переходим к следующему
		КонецПопытки;
	КонецЦикла;
	// 3. Опционально фильтруем по статусу документа
	СсылкаНаСтатус = Неопределено;
	Если ЗначениеЗаполнено(СтатусДокумента) Тогда
		Попытка
			СсылкаНаСтатус = Перечисления.ЦИТ_СтутусИнвентаризации[СтатусДокумента];
		Исключение
			// Игнорируем, если статус некорректный
		КонецПопытки;
	КонецЕсли;
	
	ДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Имей");
	
	Если НЕ ЗначениеЗаполнено(ДопРеквизит) Тогда
		Возврат Новый HTTPСервисОтвет(404, "Имей как доп_реквизит не найден");
	КонецЕсли;

	// 4. Запрос к 1С: плоский список строк с сериями и фактом
	Запрос1С = Новый Запрос;
	Запрос1С.Текст = 
    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ИнвентаризацияЗапасовП.Ссылка КАК ДокументСсылка,
    |    ИнвентаризацияЗапасовП.Дата КАК ДокументДата,
    |    ЗапасыП.Номенклатура КАК НоменклатураСсылка,
    |    ЗапасыП.Номенклатура.Наименование КАК НоменклатураНаименование,
    |    ЗапасыП.Количество КАК КоличествоПлан, // Добавляем план по строке
    |    ЕСТЬNULL(СерииНоменклатурыП.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СерияСсылка,
    |    ЕСТЬNULL(СерииНоменклатурыП.Серия.Наименование, """") КАК СерияНаименование,
    |    ИнвентаризацияЗапасовП.СтруктурнаяЕдиница КАК Склад,
    |    ИнвентаризацияЗапасовП.Номер КАК Номер,
    |    ЕСТЬNULL(ФактОстатки.Количество, 0) КАК kolichestvoFakt,
    |    ЕСТЬNULL(СерииДопРеквизиты.Значение, """") КАК imei
    |ИЗ
    |    Документ.ИнвентаризацияЗапасов КАК ИнвентаризацияЗапасовП
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИнвентаризацияЗапасов.Запасы КАК ЗапасыП
    |        ПО ИнвентаризацияЗапасовП.Ссылка = ЗапасыП.Ссылка
    |
    |        // МЕНЯЕМ НА ЛЕВОЕ СОЕДИНЕНИЕ
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнвентаризацияЗапасов.СерииНоменклатуры КАК СерииНоменклатурыП
    |        ПО (ЗапасыП.КлючСвязи = СерииНоменклатурыП.КлючСвязи)
    |            И (ЗапасыП.Ссылка = СерииНоменклатурыП.Ссылка)
    |            
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦИТ_ФактическиеОстаткиСерий КАК ФактОстатки
    |        ПО ИнвентаризацияЗапасовП.Ссылка = ФактОстатки.ИнвентаризацияЗапасов
    |            И ЗапасыП.Номенклатура = ФактОстатки.Номенклатура
    |            И СерииНоменклатурыП.Серия = ФактОстатки.Серия
    |            
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииДопРеквизиты
    |        ПО СерииНоменклатурыП.Серия = СерииДопРеквизиты.Ссылка
    |            И СерииДопРеквизиты.Свойство = &ДопРеквизит
    |ГДЕ
    |    НЕ ИнвентаризацияЗапасовП.ПометкаУдаления
    |    И ИнвентаризацияЗапасовП.СтруктурнаяЕдиница В (&МассивСсылокСкладов)
    |    И (&Статус = НЕОПРЕДЕЛЕНО ИЛИ ИнвентаризацияЗапасовП.ЦИТ_Статус = &Статус)
    |
    |УПОРЯДОЧИТЬ ПО
    |    ДокументДата"; 
	
	Запрос1С.УстановитьПараметр("ДопРеквизит", ДопРеквизит);
	Запрос1С.УстановитьПараметр("МассивСсылокСкладов", МассивСсылокСкладов);
	Запрос1С.УстановитьПараметр("Статус", СсылкаНаСтатус);

	РезультатЗапроса = Запрос1С.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// 5. Группируем плоский результат запроса в иерархию (Документы -> Товары)
	МассивДокументов = Новый Массив;
	ПредыдущийДокумент = Неопределено;
	ТекущийДокументСтруктура = Неопределено;
	
	Попытка
		Пока Выборка.Следующий() Цикл
			
			// Если мы перешли к новому документу в выборке...
			Если Выборка.ДокументСсылка <> ПредыдущийДокумент Тогда
				
				// ...сохраняем предыдущий документ, если он был
				Если ТекущийДокументСтруктура <> Неопределено Тогда
					МассивДокументов.Добавить(ТекущийДокументСтруктура);
				КонецЕсли;
				
				// И начинаем формировать новый
				ПредыдущийДокумент = Выборка.ДокументСсылка;
				ТекущийДокументСтруктура = Новый Структура;
				ТекущийДокументСтруктура.Вставить("id", Строка(ПредыдущийДокумент.УникальныйИдентификатор()));
				ТекущийДокументСтруктура.Вставить("date", Формат(Выборка.ДокументДата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
				ТекущийДокументСтруктура.Вставить("warehouse", Строка(Выборка.Склад));
				ТекущийДокументСтруктура.Вставить("documentNumber", Строка(Выборка.Номер));
				ТекущийДокументСтруктура.Вставить("items", Новый Массив); // Создаем пустой массив для позиций
			КонецЕсли;
			
			// Создаем объект товара (соответствует InventoryItem)
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("nomenklaturaId", Строка(Выборка.НоменклатураСсылка.УникальныйИдентификатор()));
			// Логика для товаров без серий: если серии нет, берем количество из строки
            ЕстьСерия = ЗначениеЗаполнено(Выборка.СерияСсылка);
            
            Если ЕстьСерия Тогда
                СтруктураТовара.Вставить("nomenklatura", Выборка.НоменклатураНаименование);
                СтруктураТовара.Вставить("seriyaId", Строка(Выборка.СерияСсылка.УникальныйИдентификатор()));
                СтруктураТовара.Вставить("seriya", Выборка.СерияНаименование);
                СтруктураТовара.Вставить("kolichestvo", 1); 
            Иначе
                // Добавляем кол-во в имя, если серии нет
                СтруктураТовара.Вставить("nomenklatura", Выборка.НоменклатураНаименование + " (" + Выборка.КоличествоПлан + " шт.)");
                СтруктураТовара.Вставить("seriyaId", ""); 
                СтруктураТовара.Вставить("seriya", "");
                СтруктураТовара.Вставить("kolichestvo", Выборка.КоличествоПлан);
            КонецЕсли;
            
            СтруктураТовара.Вставить("imei", Выборка.imei);
            СтруктураТовара.Вставить("kolichestvoFakt", Выборка.kolichestvoFakt);
            
            ТекущийДокументСтруктура.items.Добавить(СтруктураТовара);
			
		КонецЦикла;

		// Не забываем добавить последний обработанный документ в массив
		Если ТекущийДокументСтруктура <> Неопределено Тогда
			МассивДокументов.Добавить(ТекущийДокументСтруктура);
		КонецЕсли;
    Исключение 
		Возврат СформироватьОтветСОшибкой(500, "Ошибка при формировании результата в JSON: ");
	КонецПопытки;
	// 6. Преобразуем данные 1С в JSON строку
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДокументов);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	// 7. Формируем и возвращаем HTTP-ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Возврат Ответ;
КонецФункции

// Один документ инвентаризации по ID (HTTP GET)
Функция GetInventoryDocumentByIdGET(Запрос)
	// 1. Получаем параметр {id} из URL запроса
	ДокументID = Запрос.ПараметрыURL["id"];
	Если ПустаяСтрока(ДокументID) Тогда
		Возврат Новый HTTPСервисОтвет(400); // Bad Request
	КонецЕсли;
	
	// 2. Получаем ссылку на документ по его УИД
	ДокументСсылка = Документы.ИнвентаризацияЗапасов.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументID));
	
	// Если ссылка пустая - значит документ с таким ID не найден
	Если ДокументСсылка.Пустая() Тогда
		Возврат Новый HTTPСервисОтвет(404); // Not Found
	КонецЕсли; 
	
	ДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Имей");
	
	Если НЕ ЗначениеЗаполнено(ДопРеквизит) Тогда
		Возврат Новый HTTPСервисОтвет(404);
	КонецЕсли;

	// 3. Запрос для получения данных ОДНОГО документа
	Запрос1С = Новый Запрос;
	Запрос1С.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |    ИнвентаризацияЗапасовП.Ссылка КАК ДокументСсылка,
    |    ИнвентаризацияЗапасовП.Дата КАК ДокументДата,
    |    ЗапасыП.Номенклатура КАК НоменклатураСсылка,
    |    ЗапасыП.Номенклатура.Наименование КАК НоменклатураНаименование,
    |    ЗапасыП.Количество КАК КоличествоПлан,  // <--- ДОБАВИЛИ ОБЩЕЕ КОЛИЧЕСТВО СТРОКИ
    |    ЕСТЬNULL(СерииНоменклатурыП.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СерияСсылка,
    |    ЕСТЬNULL(СерииНоменклатурыП.Серия.Наименование, """") КАК СерияНаименование,
    |    ИнвентаризацияЗапасовП.СтруктурнаяЕдиница КАК Склад,
    |    ИнвентаризацияЗапасовП.Номер КАК Номер,
    |    ЕСТЬNULL(ФактОстатки.Количество, 0) КАК kolichestvoFakt,
    |    ЕСТЬNULL(СерииДопРеквизиты.Значение, """") КАК imei
    |ИЗ
    |    Документ.ИнвентаризацияЗапасов КАК ИнвентаризацияЗапасовП
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИнвентаризацияЗапасов.Запасы КАК ЗапасыП
    |        ПО ИнвентаризацияЗапасовП.Ссылка = ЗапасыП.Ссылка
    |        
    |        // ИЗМЕНЕНО НА ЛЕВОЕ СОЕДИНЕНИЕ, чтобы попадали товары без серий
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнвентаризацияЗапасов.СерииНоменклатуры КАК СерииНоменклатурыП
    |        ПО (ЗапасыП.КлючСвязи = СерииНоменклатурыП.КлючСвязи)
    |            И (ЗапасыП.Ссылка = СерииНоменклатурыП.Ссылка)
    |            
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦИТ_ФактическиеОстаткиСерий КАК ФактОстатки
    |        ПО ИнвентаризацияЗапасовП.Ссылка = ФактОстатки.ИнвентаризацияЗапасов
    |            И ЗапасыП.Номенклатура = ФактОстатки.Номенклатура
    |            И СерииНоменклатурыП.Серия = ФактОстатки.Серия
    |            
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииДопРеквизиты
    |        ПО СерииНоменклатурыП.Серия = СерииДопРеквизиты.Ссылка
    |            И СерииДопРеквизиты.Свойство = &ДопРеквизит
    |ГДЕ 
    |    ИнвентаризацияЗапасовП.Ссылка = &ДокументСсылка
    |    И НЕ ИнвентаризацияЗапасовП.ПометкаУдаления
    |
    |УПОРЯДОЧИТЬ ПО
    |    НоменклатураСсылка";

	// Устанавливаем значение параметра в запросе
	Запрос1С.УстановитьПараметр("ДокументСсылка", ДокументСсылка); 
	Запрос1С.УстановитьПараметр("ДопРеквизит", ДопРеквизит);

	РезультатЗапроса = Запрос1С.Выполнить();
	
	// Дополнительная проверка на пустой результат не нужна, 
	// так как мы уже проверили существование ссылки.
	Выборка = РезультатЗапроса.Выбрать();

	// 4. Собираем структуру для JSON-ответа (логика упрощена, т.к. документ один)
	ТекущийДокументСтруктура = Новый Структура("id, date, warehouse, documentNumber, items");
	МассивТоваров = Новый Массив;
	
	ПерваяСтрока = Истина;
	Пока Выборка.Следующий() Цикл
		// Информацию о самом документе (id, date) берем только один раз из первой строки
		Если ПерваяСтрока Тогда
			ТекущийДокументСтруктура.id = Строка(Выборка.ДокументСсылка.УникальныйИдентификатор());
			ТекущийДокументСтруктура.date = Формат(Выборка.ДокументДата, "ДФ=yyyy-MM-ddTHH:mm:ss");
			ТекущийДокументСтруктура.warehouse = Строка(Выборка.Склад);
			ТекущийДокументСтруктура.documentNumber = Строка(Выборка.Номер);
			ПерваяСтрока = Ложь;
		КонецЕсли;

		// Собираем очередную позицию товара (InventoryItem)
		СтруктураТовара = Новый Структура;
		СтруктураТовара.Вставить("nomenklaturaId", Строка(Выборка.НоменклатураСсылка.УникальныйИдентификатор()));
		// Логика для товаров без серий: если серии нет, берем количество из строки
        ЕстьСерия = ЗначениеЗаполнено(Выборка.СерияСсылка);
        
        Если ЕстьСерия Тогда
            СтруктураТовара.Вставить("nomenklatura", Выборка.НоменклатураНаименование);
            СтруктураТовара.Вставить("seriyaId", Строка(Выборка.СерияСсылка.УникальныйИдентификатор()));
            СтруктураТовара.Вставить("seriya", Выборка.СерияНаименование);
            СтруктураТовара.Вставить("kolichestvo", 1); // Одна серия = 1 штука
        Иначе
            СтруктураТовара.Вставить("nomenklatura", Выборка.НоменклатураНаименование + " (" + Выборка.КоличествоПлан + " шт.)");
            СтруктураТовара.Вставить("seriyaId", ""); // Пустой ID серии
            СтруктураТовара.Вставить("seriya", "");
            СтруктураТовара.Вставить("kolichestvo", Выборка.КоличествоПлан); // Берем количество из строки документа
        КонецЕсли;
        
        СтруктураТовара.Вставить("imei", Выборка.imei);
        СтруктураТовара.Вставить("kolichestvoFakt", Выборка.kolichestvoFakt);
        
        МассивТоваров.Добавить(СтруктураТовара);
	КонецЦикла;
	
	ТекущийДокументСтруктура.items = МассивТоваров;

	// 5. Преобразуем данные в JSON строку
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	// ВАЖНО: передаем не массив, а одну структуру документа
	ЗаписатьJSON(ЗаписьJSON, ТекущийДокументСтруктура); 
	СтрокаJSON = ЗаписьJSON.Закрыть();

	// 6. Формируем и возвращаем HTTP-ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Возврат Ответ;
КонецФункции

// Обновление факта по документу инвентаризации (HTTP POST)
Функция UpdateInventoryDocumentPOST(Запрос)
	Попытка

        // --- 1. Получаем тело POST-запроса ---
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
        Если ПустаяСтрока(ТелоЗапроса) Тогда
            Возврат СформироватьОтветСОшибкой(400, "Пустое тело запроса");
        КонецЕсли;

        // --- 2. Парсим JSON ---
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        ДанныеДокумента = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();

        // Проверим наличие обязательных полей
        Если Не ЗначениеЗаполнено(ДанныеДокумента["id"]) Тогда
            Возврат СформироватьОтветСОшибкой(400, "Не указан ID документа");
        КонецЕсли;

        // --- 3. Находим документ по УИД ---
        ДокументСсылка = Документы.ИнвентаризацияЗапасов.ПолучитьСсылку(
            Новый УникальныйИдентификатор(ДанныеДокумента["id"])
        );

        Если ДокументСсылка.Пустая() Тогда
            Возврат СформироватьОтветСОшибкой(404, "Документ не найден");
        КонецЕсли;

        // --- 4. Преобразуем JSON-данные из ТСД в таблицу значений ---
        ТаблицаДанныхТСД = Новый ТаблицаЗначений;
        ТаблицаДанныхТСД.Колонки.Добавить("Номенклатура");
        ТаблицаДанныхТСД.Колонки.Добавить("Серия");
        ТаблицаДанныхТСД.Колонки.Добавить("Количество");

		Для Каждого СтрИзJSON Из ДанныеДокумента["items"] Цикл
			КоличествоФактПров = ?(ЗначениеЗаполнено(СтрИзJSON["kolichestvoFakt"]), СтрИзJSON["kolichestvoFakt"], 0);
			Если Число(КоличествоФактПров) > 0 Тогда
	            НоваяСтрока = ТаблицаДанныхТСД.Добавить();
	            НоваяСтрока.Номенклатура = ПолучитьСсылкуНоменклатурыПоИдентификатору(СтрИзJSON["nomenklaturaId"]);
	            НоваяСтрока.Серия = ПолучитьСсылкуСерииПоИдентификатору(СтрИзJSON["seriyaId"]);
	            НоваяСтрока.Количество = ?(ЗначениеЗаполнено(СтрИзJSON["kolichestvoFakt"]), СтрИзJSON["kolichestvoFakt"], 0);
			КонецЕсли;
		КонецЦикла;

        // --- 5. Загружаем данные в регистр сведений ---
        ЗагрузитьДанныеИзТСД(ДокументСсылка, ТаблицаДанныхТСД);

        // --- 6. Возвращаем успешный ответ ---
        ДанныеОтвета = Новый Структура;
        ДанныеОтвета.Вставить("success", Истина);
        ДанныеОтвета.Вставить("message", "Данные документа успешно обновлены");

        Ответ = Новый HTTPСервисОтвет(200);
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

        Возврат Ответ;

    Исключение
        Возврат СформироватьОтветСОшибкой(500, "Ошибка при обновлении документа: " + ОписаниеОшибки());
    КонецПопытки;

КонецФункции

// Загрузка фактических остатков по документу (перезапись данных в регистре)
Процедура ЗагрузитьДанныеИзТСД(СсылкаНаДокумент, ТаблицаДанныхТСД)
    
    // Используем НаборЗаписей - это самый правильный и производительный способ
    // для массового изменения записей в регистре.
    НаборЗаписей = РегистрыСведений.ЦИТ_ФактическиеОстаткиСерий.СоздатьНаборЗаписей();
    
    // --- ШАГ 1: ОЧИСТКА СТАРЫХ ДАННЫХ ---
    // Устанавливаем отбор по нашему документу. Это ключевой момент.
    НаборЗаписей.Отбор.ИнвентаризацияЗапасов.Установить(СсылкаНаДокумент);
    
    // Считываем существующие записи (хотя нам нужно их просто удалить, 
    // это стандартная практика перед записью). Можно и не читать.
    НаборЗаписей.Прочитать(); 
    
    // Очищаем набор. Это пока что "виртуальное" удаление в памяти.
    НаборЗаписей.Очистить();
    
    // Записываем пустой набор с установленным отбором. 
    // Этот вызов физически удалит из базы данных ВСЕ записи, 
    // относящиеся к нашему документу.
    НаборЗаписей.Записать(); 
    
    
    // --- ШАГ 2: ЗАГРУЗКА НОВЫХ ДАННЫХ ---
    // Теперь, когда регистр чист для этого документа, снова создаем набор записей.
    НаборЗаписей = РегистрыСведений.ЦИТ_ФактическиеОстаткиСерий.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.ИнвентаризацияЗапасов.Установить(СсылкаНаДокумент);
    
    // Обходим данные из файла ТСД и добавляем их в набор
    Для Каждого СтрокаТСД Из ТаблицаДанныхТСД Цикл
        
        НоваяЗапись = НаборЗаписей.Добавить();
        
        // Заполняем измерения
        НоваяЗапись.ИнвентаризацияЗапасов = СсылкаНаДокумент;
        НоваяЗапись.Номенклатура = СтрокаТСД.Номенклатура;
        НоваяЗапись.Серия = СтрокаТСД.Серия;
        
        // Заполняем ресурс
        НоваяЗапись.Количество = СтрокаТСД.Количество;
        
    КонецЦикла;
    
    // Записываем весь набор одной транзакцией. Это очень быстро.
    НаборЗаписей.Записать();
    
КонецПроцедуры 

Функция СформироватьОтветСОшибкой(Код, Сообщение)
	Ответ = Новый HTTPСервисОтвет(Код);
    ДанныеОтвета = Новый Структура("success, message", Ложь, Сообщение);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции  

// Вспомогательная функция для успешного ответа
Функция СформироватьУспешныйОтветJSON(Данные)
    Ответ = Новый HTTPСервисОтвет(200);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
