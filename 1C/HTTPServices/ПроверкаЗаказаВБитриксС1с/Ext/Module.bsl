
// Обработчик для метода POST в шаблоне
Функция ШаблонURL1ПроверитьЗаказ(Запрос)
	//Результат = Новый Структура;
    //Результат.Вставить("Совпадение", Истина); // Изначально считаем, что все совпадает
    //Результат.Вставить("Сообщения", Новый Массив); 
    //Результат.Сообщения.Добавить("Все данные совпадают.");
    //КодСостояния = ?(Результат.Совпадение, 200, 200); // 200 - OK в любом случае, результат в теле
	//Возврат СформироватьОтветJSON(КодСостояния, Результат);
	//Ответ = Новый HTTPСервисОтвет(200);
	//Возврат Ответ; 
	
	// 1. Получаем и разбираем JSON из тела запроса
	ТелоЗапросаСтрокой = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Если ПустаяСтрока(ТелоЗапросаСтрокой) Тогда
	    Возврат СформироватьОтветОшибки(400, "Тело запроса не может быть пустым.");
	КонецЕсли;

	Попытка
	    ЧтениеJSON = Новый ЧтениеJSON;
	    ЧтениеJSON.УстановитьСтроку(ТелоЗапросаСтрокой);
	    ДанныеCRM = ПрочитатьJSON(ЧтениеJSON, Истина);
	    ЧтениеJSON.Закрыть();
	Исключение
	    Возврат СформироватьОтветОшибки(400, "Ошибка разбора JSON: " + ОписаниеОшибки());
	КонецПопытки;

	// 2. Находим документ "Заказ клиента" в 1С
	ID_Сделки_CRM = Строка(ДанныеCRM["DEAL_ID"]);
	НайденныйДокумент = НайтиЗаказКлиентаПоID_CRM(ID_Сделки_CRM);
	
	Если НайденныйДокумент.Пустая() Тогда
	    Возврат СформироватьОтветОшибки(404, "Заказ клиента для сделки с ID '" + ID_Сделки_CRM + "' не найден в 1С.");
	КонецЕсли; 
	
	// ======================== НОВЫЙ БЛОК: ПРОВЕРКА ДАТЫ ДОКУМЕНТА (Упрощенный вариант) ========================
	// Если дата найденного документа меньше 05.08.2025, то проверку не выполнять.
	
	// Создаем константу с датой отсечки.
	// Формат 'ГГГГММДД' - самый надежный способ задать дату без времени.
	ДатаОтсечки = '20250805'; 
	
	// Сравниваем только ДАТЫ, отбрасывая время.
	// Функция Дата() как раз и отсекает время от реквизита типа "Дата".
	Если НайденныйДокумент.Дата < ДатаОтсечки Тогда
		
		// Формируем стандартный успешный ответ
		Результат = Новый Структура;
		Результат.Вставить("Совпадение", Истина);
		Результат.Вставить("Сообщения", Новый Массив); 
		Результат.Сообщения.Добавить("Все данные совпадают.");
		
		Возврат СформироватьОтветJSON(200, Результат);
	КонецЕсли;
	// =========================================================================================================
	
	// 3. Запускаем процесс сверки данных
	Попытка
	    РезультатСверки = СверитьДанныеЗаказа(НайденныйДокумент, ДанныеCRM);
	    
	    // 4. Формируем и возвращаем успешный ответ с результатами
	    КодСостояния = ?(РезультатСверки.Совпадение, 200, 200); // 200 - OK в любом случае, результат в теле
	    Возврат СформироватьОтветJSON(КодСостояния, РезультатСверки);
	    
	Исключение
	    Возврат СформироватьОтветОшибки(500, "Ошибка при сверке данных: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

