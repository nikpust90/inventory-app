// Вспомогательная функция для расчета итоговой цены за одну единицу товара из CRM.
// Это делает основной код чище и позволяет избежать дублирования.
&НаСервере
Функция РассчитатьИтоговуюЦенуЗаШтукуCRM(СтрокаCRM)
	
	// 1. Определяем базовую цену за штуку (с НДС или без)
	//
	Если СтрокаCRM["TAX_INCLUDED"] = "Y" Тогда
		ЦенаЗаШтуку = Число(СтрокаCRM["PRICE_BRUTTO"]);
	Иначе
		ЦенаЗаШтуку = Число(СтрокаCRM["PRICE_NETTO"]); 
	КонецЕсли;
	
	// 2. Вычитаем скидку на единицу товара
	// DISCOUNT_SUM в данных Битрикс уже указана на одну единицу.
	ЦенаСоСкидкойЗаШтуку = ЦенаЗаШтуку - Число(СтрокаCRM["DISCOUNT_SUM"]);
	
	// 3. Если НДС не был включен в цену, добавляем его сверху
	//
	Если СтрокаCRM["TAX_RATE"] <> Неопределено И (СтрокаCRM["TAX_INCLUDED"] = "N") И (Число(СтрокаCRM["TAX_RATE"]) <> 0) Тогда  
		ИтоговаяЦенаЗаШтуку = ЦенаСоСкидкойЗаШтуку + ЦенаСоСкидкойЗаШтуку * (Число(СтрокаCRM["TAX_RATE"]) / 100);
	Иначе 
		ИтоговаяЦенаЗаШтуку = ЦенаСоСкидкойЗаШтуку;   
	КонецЕсли;
	
	// Округляем до копеек для точности сравнения
	Возврат Окр(ИтоговаяЦенаЗаШтуку, 2);
	
КонецФункции

Функция НайтиЗаказКлиентаПоID_CRM(ID_Сделки)
    // Самый надежный способ - использовать дополнительный реквизит для хранения ID из CRM.
    // Как вариант - поиск по комментарию, но он менее надежен.
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ЗаказПокупателя.Ссылка КАК Ссылка
        |ИЗ
        |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
        |ГДЕ
        |	ЗаказПокупателя.Номер = &Номер"; 
        
    Запрос.УстановитьПараметр("Номер", ID_Сделки);
    
    Результат = Запрос.Выполнить().Выбрать();
    
    Если Результат.Следующий() Тогда
        Возврат Результат.Ссылка;
    Иначе
        Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
    КонецЕсли;
КонецФункции

